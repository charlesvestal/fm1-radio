+/* TEST: the decoder's blocks as allocated (their heap headers, 8 bytes after its memory) */
+static uint32_t tg_hdr[3], tg_n, tg_noted;
+static void tg_set(void)
+{
+    tg_hdr[0] = ((uint32_t *)aac_ext)[-1];
+    tg_hdr[1] = ((uint32_t *)aac_mem)[-1];
+    tg_hdr[2] = ((uint32_t *)aac_out)[-1];
+    tg_n = PVMP4AudioDecoderGetMemRequirements();
+    memset((uint8_t *)aac_mem + tg_n, 0xA5, 8);
+}
+static void tg_check(const char *where)
+{
+    extern void shim_log(const char *);
+    extern int shim_heap_check(void);
+    int bad = 0, k;
+    if (dec_kind == 2) {
+        if (((uint32_t *)aac_ext)[-1] != tg_hdr[0]) bad |= 1;
+        if (((uint32_t *)aac_mem)[-1] != tg_hdr[1]) bad |= 2;
+        if (((uint32_t *)aac_out)[-1] != tg_hdr[2]) bad |= 4;
+        for (k = 0; k < 8; k++)
+            if (((uint8_t *)aac_mem)[tg_n + k] != 0xA5) bad |= 8;
+    }
+    if (bad && tg_noted < 4) {
+        char t[32];
+        tg_noted++;
+        w_cpy(t, "guard x ", sizeof t);
+        t[6] = (char)('0' + bad);
+        w_cpy(t + 8, where, 20);
+        shim_log(t);
+        if (dec_kind == 2)
+            tg_set();
+    }
+    if (shim_heap_check() && tg_noted < 8)
+        tg_noted++;
+}
