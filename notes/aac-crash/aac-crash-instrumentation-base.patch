+static int in_heap(const void *p, uint32_t n)       /* [p, p + n) inside one part of the heap */
+{
+    const uint8_t *a = p;
+    if (a >= (const uint8_t *)heap && a + n <= (const uint8_t *)heap + HEAP_BYTES)
+        return 1;
+#if SHIM_WIFI
+    if (a >= (const uint8_t *)heap2 && a + n <= (const uint8_t *)heap2 + HEAP2_BYTES)
+        return 1;
+#endif
+    return 0;
+}
+static void heap_note(const char *what, uint32_t v)
+{
+    static const char hx[] = "0123456789ABCDEF";
+    char t[40];
+    uint32_t k = 0, j;
+    while (*what && k < 28u)
+        t[k++] = *what++;
+    t[k++] = ' ';
+    for (j = 0; j < 8u; j++)
+        t[k++] = hx[(v >> (28 - 4 * j)) & 15u];
+    t[k] = 0;
+    shim_log(t);
+}
+/* the free list in order: each block inside the heap, 8-aligned, apart from the next (0 = whole) */
+int shim_heap_check(void)
+{
+    uint32_t f = shim_irq_save();
+    const blk_t *b;
+    int bad = 0;
+    for (b = free_list; b && !bad; b = b->next)
+        if (((uintptr_t)b & 7u) || b->size < 8u || (b->size & 7u) || !in_heap(b, b->size) ||
+            (b->next && (const uint8_t *)b + b->size >= (const uint8_t *)b->next))
+            bad = 1;
+    shim_irq_restore(f);
+    if (bad)
+        heap_note("heap: free list broken at", (uint32_t)(uintptr_t)b);
+    return bad;
+}
